# Copy to .env.local and adjust.

# Signs the session cookie. Required in production: openssl rand -base64 32
AUTH_SECRET=

# Password for the demo accounts (admin@, writer@, analyst@, viewer@proposalpanda.dev).
# Defaults to "password" in development; demo login is disabled in production unless this is set.
DEMO_PASSWORD=

# Local models served by Ollama (https://ollama.com). Pull them first:
#   ollama pull llama3 && ollama pull qwen2.5:3b-instruct
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ANALYSIS_MODEL=qwen2.5:3b-instruct
OLLAMA_BID_MODEL=llama3:latest
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_MS=120000
